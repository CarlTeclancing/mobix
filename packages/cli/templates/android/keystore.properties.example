# Copy to keystore.properties and fill in on your machine. Never commit this file.
# The Android build reads these values, or the equivalent environment variables:
# MOBIX_KEYSTORE_FILE, MOBIX_KEYSTORE_PASSWORD, MOBIX_KEY_ALIAS, MOBIX_KEY_PASSWORD.
storeFile=/absolute/path/to/release.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
